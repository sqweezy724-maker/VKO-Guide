<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="backgroundColor">#ffffff</color>
    <color name="colorAccent">#16a34a</color>
    <color name="colorPrimary">#15803d</color>
    <color name="colorPrimaryDark">#14532d</color>
    <color name="navigationColor">#000000</color>
    <color name="navigationColorDark">#000000</color>
    <string name="app_name">ВКО Гид</string>
    <string name="app_short_name">ВКО Гид</string>
    <style name="Theme.TWA" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/navigationColor</item>
    </style>
    <style name="Theme.TWA.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.TWA</item>
    </style>
</resources>